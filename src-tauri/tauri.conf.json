{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "domado",
  "version": "3.0.2",
  "identifier": "domado",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist-tauri",
    "beforeDevCommand": "vite -c vite.tauri.config.ts",
    "beforeBuildCommand": "vite build -c vite.tauri.config.ts"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/32x32.png", "icons/128x128.png"],
    "resources": { "../assets/icon_22x22.png": "icon_22x22.png" }
  }
}
