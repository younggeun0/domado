{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "domado",
  "version": "../package.json",
  "identifier": "domado",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "beforeBundleCommand": "npm run build:widget"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/32x32.png", "icons/128x128.png"],
    "resources": { "../assets/icon_22x22.png": "icon_22x22.png" },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "files": {
        "PlugIns/DomadoWidget.appex": "widget/build/Release/DomadoWidget.appex"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MkIxQzMwNDBGNUVEQTcKUldTbjdmVkFNQndyWjdSbXhJUjVURjhScmdaVlc3QXR4d0RzcjJqTG9HaGk5aE1DcTJZRVdCVFQK",
      "endpoints": ["https://github.com/younggeun0/domado/releases/latest/download/latest.json"]
    }
  }
}
